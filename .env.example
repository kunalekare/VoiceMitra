# SkillBridge Environment Configuration

# Server Port & Mode
PORT=3000
NODE_ENV=development

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# JWT Authentication Secrets
JWT_SECRET=skillbridge-super-secret-jwt-key-2026
REFRESH_SECRET=skillbridge-super-secret-refresh-key-2026

# DPDP Privacy Pepper Secret (for Aadhaar duplicate prevention hashing)
AADHAAR_PEPPER=skillbridge-pepper-secret-salted-2026

# Razorpay Escrow Integration (Leave empty for Sandbox Simulator Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
